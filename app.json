{
  "expo": {
    "name": "NearLoop",
    "slug": "nearloop",
    "owner": "shouryaisallyouneeds-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nearloop",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fffaf7",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#fffaf7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.nearloop"
    },
    "android": {
      "package": "com.yourname.nearloop",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      }
    },
    "plugins": [
      "expo-image-picker"
    ]
  }
}
